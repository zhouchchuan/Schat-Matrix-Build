+    private func encodeStereoOpus(_ source: AVAudioFile, to destinationURL: URL) throws {
+        let format = source.processingFormat
+        // SwiftOGG's M4A helper reads planar PCM and only passes the first channel.
+        let encoder = try OGGEncoder(format: format.streamDescription.pointee,
+                                     opusRate: Int32(format.sampleRate),
+                                     application: .audio)
+        let framesPerPacket = Int(format.sampleRate) / 50
+        guard let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(framesPerPacket * 50)),
+              FileManager.default.createFile(atPath: destinationURL.path, contents: nil) else {
+            throw AudioConverterError.conversionFailed(nil)
+        }
+        let destination = try FileHandle(forWritingTo: destinationURL)
+        defer { try? destination.close() }
+
+        while source.framePosition < source.length {
+            try source.read(into: buffer)
+            let frameCount = Int(buffer.frameLength)
+            let pcm = buffer.audioBufferList.pointee.mBuffers
+            guard frameCount > 0, let data = pcm.mData else {
+                throw AudioConverterError.conversionFailed(nil)
+            }
+            var samples = Data(bytes: data, count: Int(pcm.mDataByteSize))
+            let finalPacketFrames = frameCount % framesPerPacket
+            if source.framePosition == source.length, finalPacketFrames != 0 {
+                let frameSize = Int(format.streamDescription.pointee.mBytesPerFrame)
+                samples.append(Data(count: (framesPerPacket - finalPacketFrames) * frameSize))
+            }
+            try encoder.encode(pcm: samples)
+            try destination.write(contentsOf: encoder.bitstream())
+        }
+        try destination.write(contentsOf: encoder.bitstream(flush: true))
