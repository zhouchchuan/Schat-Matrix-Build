+            .setEnableDecoderFallback(true)
+            .setMediaCodecSelector { mimeType, secure, tunneling ->
+                val decoders = MediaCodecSelector.DEFAULT.getDecoderInfos(mimeType, secure, tunneling)
+                // Prefer the platform software decoder for short Opus voice notes, with the vendor decoder as a fallback.
+                if (mimeType == MimeTypes.AUDIO_OPUS) decoders.sortedByDescending { it.softwareOnly } else decoders
+            }
+        val attributes = AudioAttributes.Builder()
+            .setUsage(C.USAGE_MEDIA)
+            .setContentType(C.AUDIO_CONTENT_TYPE_SPEECH)
+            .build()
+        val player = ExoPlayer.Builder(context, renderers)
+            .setWakeMode(C.WAKE_MODE_LOCAL)
+            // The voice message player already manages audio focus.
+            .setAudioAttributes(attributes, false)
+            .build()
+        return DefaultSimplePlayer(player)
+    }
 }
